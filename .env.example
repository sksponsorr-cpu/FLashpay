# Keep these values in a local .env.local file on the server only.
# Real collections remain blocked until authentication, durable storage, and
# written Swychr approval are implemented. This flag only enables live method lookup.
SWYCHR_LIVE_PAYMENTS_ENABLED=false
SWYCHR_PROVIDER_LOOKUPS_ENABLED=false
SWYCHR_API_KEY=
SWYCHR_WEBHOOK_SECRET=

# Supabase project URL and publishable key (from Project Settings > API).
# These are public client configuration values, safe for the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase service role key: SERVER ONLY. Used only by the Swychr webhook to record payments.
# Never name it NEXT_PUBLIC_..., never put it in browser code, never commit it.
SUPABASE_SERVICE_ROLE_KEY=

# Clés live : laisser à false. Ne passer à true qu après accord écrit de Swychr et mise en place des transactions.
LIVE_API_KEYS_ENABLED=false
